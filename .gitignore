# ============================================================================
# ZIT6 AUV .gitignore
# ============================================================================

# ---- 编译输出 ----
build/
build_ninja/
build_tests/
# Colcon build roots with an environment suffix (for example build_foxy).
/build_*/
/install_*/
/log_*/
bin/
obj/
install/
log/

# ---- 静态库和中间文件 ----
*.elf
*.bin
*.hex
*.map
*.o
*.obj
*.su
*.a

# ---- IDE/编辑器 ----
.settings/
.project
.cproject
.mxproject
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
.idea/

# ---- 代码生成器输出 ----
# gen_config.py 自动生成，编辑 scripts/templates/SystemConfig.hpp.j2 替代
UserApp/Config/SystemConfig.hpp
UserApp/Config/SystemConfig.cpp
UserApp/Peripherals/HAL/Core/Inc/SystemConfig.hpp
UserApp/Peripherals/HAL/Core/Inc/SystemConfig.cpp

# ---- micro-ROS 构建产物 ----
# Docker 构建生成的静态库和构建缓存
UserApp/Thirdparty/micro_ros_stm32cubemx_utils/microros_static_library_ide/libmicroro*
# build_lib.sh 在构建前自动拷贝的接口副本
UserApp/Thirdparty/micro_ros_stm32cubemx_utils/microros_static_library_ide/library_generation/extra_packages/

# ---- 构建缓存哈希 ----
.msg_hash

# ---- Python 缓存 ----
**/__pycache__/
**/.pytest_cache/
*.pyc

# ---- 文档 LaTeX 构建产物 ----
# 保留 docs 下的 PDF 和 TeX 源文件，只忽略编译过程中生成的辅助文件。
docs/**/*.aux
docs/**/*.bbl
docs/**/*.bcf
docs/**/*.blg
docs/**/*.fdb_latexmk
docs/**/*.fls
docs/**/*.idx
docs/**/*.ilg
docs/**/*.ind
docs/**/*.lof
docs/**/*.log
docs/**/*.lot
docs/**/*.nav
docs/**/*.out
docs/**/*.run.xml
docs/**/*.snm
docs/**/*.synctex*
docs/**/*.toc
docs/**/*.vrb
docs/**/*.xdv

# ---- CubeMX 生成的可选文件 ----
*.bak
*~

# ---- 用户配置 ----
# Ignore local configuration/presets in any subdirectory, but keep the
# repository-root preset under version control.
**/config.json
**/CMakePresets.json
!/CMakePresets.json

# ---- 用户文档工作区 ----
/Usr/
