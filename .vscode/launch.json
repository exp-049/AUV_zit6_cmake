{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Service Call (PID)",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${env:PYTHONPATH}:${workspaceFolder}/install/zit6_interfaces/lib/python3.12/site-packages"
            },
            "args": []
        },
        {
            "name": "Cortex Debug (DAPLink/pyOCD)",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/UserApp/AUV_zit6.elf",
            "request": "launch",
            "type": "cortex-debug",
            "runToEntryPoint": "main",
            "servertype": "pyocd",
            "serverpath": "/home/doc049/.local/bin/pyocd-gdbserver",
            "gdbPath": "/usr/bin/gdb-multiarch",
            "device": "STM32H743ZIT6",
            "targetId": "stm32h743xx",
            "boardId": "6894719E6D7C",
            "serverArgs": [
                "--frequency",
                "2000000",
                "--option",
                "reset_type=sysresetreq",
                "--option",
                "load.pre_reset=off",
                "--option",
                "load.post_reset=sysresetreq"
            ],
            "preLaunchTask": "Build Firmware"
        }
    ]
}
