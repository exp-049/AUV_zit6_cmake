{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Firmware",
            "type": "shell",
            "command": "cmake --build --preset Debug",
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Build MS5837 CAL Debug",
            "type": "shell",
            "command": "cmake --build --preset MS5837_CAL_DEBUG",
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Build USBL Debug",
            "type": "shell",
            "command": "cmake --build --preset USBL_DEBUG",
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Build INS Debug",
            "type": "shell",
            "command": "cmake --build --preset INS_DEBUG",
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Flash Firmware (DAPLink)",
            "type": "shell",
            "command": "${env:HOME}/.local/bin/pyocd",
            "args": [
                "load",
                "--target",
                "stm32h743xx",
                "--uid",
                "6894719E6D7C",
                "--frequency",
                "2m",
                "--connect",
                "attach",
                "--erase",
                "sector",
                "-O",
                "load.pre_reset=off",
                "-O",
                "load.post_reset=sysresetreq",
                "${workspaceFolder}/build/Debug/UserApp/AUV_zit6.elf"
            ],
            "dependsOn": "Build Firmware",
            "dependsOrder": "sequence",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Reset Target (DAPLink)",
            "type": "shell",
            "command": "${env:HOME}/.local/bin/pyocd",
            "args": [
                "commander",
                "--target",
                "stm32h743xx",
                "--uid",
                "6894719E6D7C",
                "--frequency",
                "2m",
                "--connect",
                "attach",
                "--command",
                "reset sysresetreq"
            ],
            "problemMatcher": []
        },
        {
            "label": "Flash MS5837 CAL Debug (DAPLink)",
            "type": "shell",
            "command": "${env:HOME}/.local/bin/pyocd",
            "args": [
                "load", "--target", "stm32h743xx", "--uid", "6894719E6D7C",
                "--frequency", "2m", "--connect", "attach", "--erase", "sector",
                "-O", "load.pre_reset=off", "-O", "load.post_reset=sysresetreq",
                "${workspaceFolder}/build/MS5837_CAL_DEBUG/UserApp/AUV_zit6.elf"
            ],
            "dependsOn": "Build MS5837 CAL Debug",
            "dependsOrder": "sequence",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "View MS5837 RTT (DAPLink)",
            "type": "shell",
            "command": "bash",
            "args": [
                "${workspaceFolder}/scripts/view_ms5837_rtt.sh"
            ],
            "dependsOn": "Flash MS5837 CAL Debug (DAPLink)",
            "dependsOrder": "sequence",
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "showReuseMessage": false,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "Flash USBL Debug (DAPLink)",
            "type": "shell",
            "command": "${env:HOME}/.local/bin/pyocd",
            "args": [
                "load", "--target", "stm32h743xx", "--uid", "6894719E6D7C",
                "--frequency", "2m", "--connect", "attach", "--erase", "sector",
                "-O", "load.pre_reset=off", "-O", "load.post_reset=sysresetreq",
                "${workspaceFolder}/build/USBL_DEBUG/UserApp/AUV_zit6.elf"
            ],
            "dependsOn": "Build USBL Debug",
            "dependsOrder": "sequence",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Flash INS Debug (DAPLink)",
            "type": "shell",
            "command": "${env:HOME}/.local/bin/pyocd",
            "args": [
                "load", "--target", "stm32h743xx", "--uid", "6894719E6D7C",
                "--frequency", "2m", "--connect", "attach", "--erase", "sector",
                "-O", "load.pre_reset=off", "-O", "load.post_reset=sysresetreq",
                "${workspaceFolder}/build/INS_DEBUG/UserApp/AUV_zit6.elf"
            ],
            "dependsOn": "Build INS Debug",
            "dependsOrder": "sequence",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Flash Firmware (ST-Link)",
            "type": "shell",
            "command": "openocd -f interface/stlink.cfg -c 'transport select hla_swd' -c 'adapter speed 100' -f target/stm32h7x.cfg -c 'program build/Debug/UserApp/AUV_zit6.elf verify reset exit'",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Flash Firmware (J-Link)",
            "type": "shell",
            "command": "openocd -f interface/jlink.cfg -c 'transport select swd' -c 'adapter speed 100' -c 'reset_config srst_only srst_nogate connect_assert_srst' -f target/stm32h7x.cfg -c 'program build/Debug/UserApp/AUV_zit6.elf verify reset exit'",
            "group": "build",
            "problemMatcher": []
        }
    ]
}
